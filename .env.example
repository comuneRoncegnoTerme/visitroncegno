# Public/server-side Directus endpoint used by the Next.js application.
DIRECTUS_URL=http://127.0.0.1:8055

# Optional service token for server-side Directus reads that require authentication.
DIRECTUS_TOKEN=

# Content Hub authentication. Use a random secret of at least 32 characters.
CONTENT_HUB_SESSION_SECRET=

# Comma-separated Directus role names allowed to access the Content Hub.
CONTENT_HUB_ALLOWED_ROLES=

# Keep true in HTTPS production. Set false only for local HTTP development.
CONTENT_HUB_COOKIE_SECURE=true
