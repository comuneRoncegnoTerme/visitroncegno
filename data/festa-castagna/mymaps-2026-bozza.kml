    <Folder>
      <name>EVENTI PRINCIPALI DELLA FESTA</name>
      <Placemark>
        <name>SCULTORI DEL LEGNO: LE LEGGENDE DI RONCEGNO</name>
        <description><![CDATA[Venerdì, sabato e domenica dalle 10:00 alle 17:00.<br>Piazzale di Villa Waiz.]]></description>
        <Point>
          <coordinates>11.409382,46.050971,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>CASA RAPHAEL</name>
        <description><![CDATA[Venerdì alle 18:00, Sala Camino: presentazione del libro “Vocabolario della parlata dialettale di Stivor”, a cura di Stivor ETS.<br>Venerdì alle 20:30, Salone delle Feste: concerto dei Valsugana Singers.]]></description>
        <Point>
          <coordinates>11.409148,46.049861,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>PIAZZETTA DEL CORO</name>
        <description><![CDATA[Apericoro venerdì e sabato dalle 18:00, con cicchetti e musica.<br>Punto ristoro del Coro S. Osvaldo con arrosticini, patatine e crêpes nel piazzale del Municipio.]]></description>
        <Point>
          <coordinates>11.410036,46.050776,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>GSD CALCIO: PRESENTAZIONE SQUADRE</name>
        <description><![CDATA[Venerdì alle 18:30: le squadre e lo staff tecnico del GSD Roncegno.]]></description>
        <Point>
          <coordinates>11.411587,46.049384,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>PIAZZALE DEI VIGILI DEL FUOCO</name>
        <description><![CDATA[Venerdì 20:30: GlockenThurm in concerto.<br>Sabato 13:30–17:30 e domenica 13:00–17:30: musica con i Trifisa.<br>Sabato 20:30: The Capston, rock anni ’70 e ’80.<br>Sabato 22:30: DJ set ErickLoud.]]></description>
        <Point>
          <coordinates>11.411545,46.049440,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>GIRO IN ELICOTTERO</name>
        <description><![CDATA[Domenica dalle 12:00 alle 17:00, nella zona del piazzale dei Vigili del Fuoco.]]></description>
        <Point>
          <coordinates>11.411845,46.049140,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>PARTENZA PASSEGGIATA</name>
        <description><![CDATA[Sabato e domenica alle 9:30 dal Municipio.<br>Passeggiata tra i castagni con i custodi forestali e gli accompagnatori di media montagna. Durata 2 ore.]]></description>
        <Point>
          <coordinates>11.409795,46.050987,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>INAUGURAZIONE E TORTA GIGANTE</name>
        <description><![CDATA[Sabato alle 14:00 al Parco delle Terme.]]></description>
        <Point>
          <coordinates>11.409430,46.050050,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>DJ SET STEFANO CENCI</name>
        <description><![CDATA[Sabato alle 21:00 in Piazza Montebello.]]></description>
        <Point>
          <coordinates>11.410470,46.052876,0</coordinates>
        </Point>
      </Placemark>
    </Folder>
    <Folder>
      <name>PER BAMBINI E FAMIGLIE</name>
      <Placemark>
        <name>SPAZIO FAMIGLIE E MERCATINO</name>
        <description><![CDATA[Novità 2026: sabato e domenica dalle 9:00 al Parco delle Terme.]]></description>
        <Point>
          <coordinates>11.409430,46.049900,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>IL BOSCO INCANTATO</name>
        <description><![CDATA[Sabato e domenica dalle 10:00 alle 18:30: laboratorio e caccia al tesoro a cura di Studio Irydea.]]></description>
        <Point>
          <coordinates>11.409230,46.049800,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>ANIMACRI</name>
        <description><![CDATA[Sabato e domenica dalle 14:00 alle 18:00: animazione e spettacoli per bambini.]]></description>
        <Point>
          <coordinates>11.409630,46.049800,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>PARCO GIOCHI SOPRA PIAZZA MONTEBELLO</name>
        <description><![CDATA[Sabato alle 14:30: “Il bambino amico dei ricci”, favola sulle castagne con Giuliano e Dante Libero Comin.<br>Sabato alle 15:00: Prova lo strumento, con la Banda Civica Lagorai.]]></description>
        <Point>
          <coordinates>11.411725,46.053529,0</coordinates>
        </Point>
      </Placemark>
    </Folder>
