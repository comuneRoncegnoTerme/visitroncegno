      <Placemark>
        <name>R.O.C.</name>
        <description><![CDATA[Stand a cura dell’Associazione Roncegno Oltre i Confini<br>Proposte gastronomiche:<br>• PANINO WÜRSTEL<br>• PANINO PULLED PORK<br>• PANINO SALSICCIA<br>• PANINO PORCHETTA<br>• PANINO VEGETARIANO<br>• TIRAMISÙ<br>• BIRRA<br>• PROSECCO<br>• BIBITE E ACQUA<br>• GIN TONIC<br>• GIN LEMON]]></description>
        <styleUrl>#icon-1577-F57C00</styleUrl>
        <Point>
          <coordinates>
            11.4096622,46.0510443,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>VILLA ROSA</name>
        <description><![CDATA[Stand gastronomico a cura del Ristorante Villa Rosa.<br>Proposte gastronomiche:<br>• TORTEL DI PATATE CON LONZINO E CAPPUCCIO CONDITO<br>• POLENTA CONCIA<br>• CANEDERLO, CRAUTI E GOULASCH<br>• TIRAMISÙ ALLE CASTAGNE<br>• PANINO CON SALSICCIA, PEPERONI E CIPOLLE]]></description>
        <styleUrl>#icon-1577-F57C00</styleUrl>
        <Point>
          <coordinates>
            11.4098938,46.0515389,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>COMITATO TRADIZIONI LOCALI</name>
        <description><![CDATA[Stand a cura del Comitato Tradizioni Locali.<br>Proposte gastronomiche:<br>• PUNTINE IN UMIDO CON CECI, FAGIOLI, POLENTA E UNA SPOLVERATA DI GRANIGLIA DI CASTAGNE<br>• ARROSTO AL SUGO DI CASTAGNE CON CECI, FAGIOLI, POLENTA E UNA SPOLVERATA DI GRANIGLIA DI CASTAGNE<br>• SPEZZATINO DI CERVO CON CECI, FAGIOLI, POLENTA E UNA SPOLVERATA DI GRANIGLIA DI CASTAGNE<br>• PIATTO VEGETARIANO CON FORMAGGIO E PEPERONATA<br>• PATATE FRITTE<br>• PANINO CON PORCHETTA E FORMAGGIO]]></description>
        <styleUrl>#icon-1577-F57C00</styleUrl>
        <Point>
          <coordinates>
            11.4102826,46.052742,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>SCI CLUB FRAVORT</name>
        <description><![CDATA[Stand a cura dello Sci Club Fravor.<br>Proposte gastronomiche:<br>• STRAUBEN ACCOMPAGNATI DA MARMELLATA DI CASTAGNE<br>• STRAUBEN CON MARMELLATA DI MIRTILLO ROSSO<br>• STRAUBEN CON NUTELLA<br>• PARAMPAMPOLI]]></description>
        <styleUrl>#icon-1577-F57C00</styleUrl>
        <Point>
